{
  "name": "rwkv-vtuber",
  "private": true,
  "version": "1.5.18",
  "description": "RWKV-VTuber is an AI-powered virtual tuber application with Live2D integration",
  "author": "leafyee.xyz",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run electron:compile && concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "release:create": "commit-and-tag-version",
    "release:push": "git push --follow-tags",
    "electron:compile": "tsc -p electron/tsconfig.json",
    "electron:build": "npm run electron:compile && vite build && electron-builder",
    "electron:build:mac": "npm run electron:compile && vite build && electron-builder --mac --arm64",
    "electron:build:win": "npm run electron:compile && vite build && electron-builder --win",
    "electron:build:linux": "npm run electron:compile && vite build && electron-builder --linux",
    "electron:build:all": "npm run electron:compile && vite build && electron-builder --mac --win --linux",
    "type-check": "tsc --noEmit --project tsconfig.json"
  },
  "build": {
    "appId": "com.leafyee.rwkv-vtuber",
    "productName": "RWKV-VTuber",
    "copyright": "Copyright © 2024 leafyee.xyz",
    "publish": [
      {
        "provider": "github",
        "owner": "xun082",
        "repo": "RWKV-VTuber",
        "releaseType": "release"
      }
    ],
    "compression": "maximum",
    "directories": {
      "output": "dist",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*.js",
      "!dist-electron/models/**/*",
      "!electron/**/*",
      "!**/.DS_Store"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": null,
      "entitlementsInherit": null,
      "asarUnpack": [
        "**/node_modules/sherpa-onnx*/**/*"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "icon": "electron/resources/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "asarUnpack": [
        "**/node_modules/sherpa-onnx*/**/*"
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "asarUnpack": [
        "**/node_modules/sherpa-onnx*/**/*"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RWKV-VTuber",
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-${version}-${arch}-Setup.${ext}",
      "differentialPackage": true
    }
  },
  "commit-and-tag-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "refactor",
        "section": "Refactoring"
      },
      {
        "type": "perf",
        "section": "Improvements"
      }
    ]
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.2.0",
    "electron-updater": "^6.6.2",
    "emoji-regex": "^10.4.0",
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.2.1",
    "l2d": "^1.0.0",
    "lucide-react": "^0.543.0",
    "markdown-it": "^14.1.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^3.0.5",
    "react-router-dom": "^7.8.2",
    "sherpa-onnx": "^1.12.15",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@tailwindcss/vite": "^4.0.13",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "commit-and-tag-version": "^12.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "globals": "^15.15.0",
    "tailwindcss": "^4.0.13",
    "tsx": "^4.20.5",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.6.3",
    "vite": "^6.2.1",
    "wait-on": "^9.0.1"
  }
}
